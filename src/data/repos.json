    {
        "name": "CRAN",
        "title": "The Comprehensive R Archive Network",
        "description": "The canonical R package repository, through the cloud.r-project.org CDN.",
        "enabled": true,
        "repos": [
            {
                "name": "CRAN",
                "url": "https://cloud.r-project.org"
            }
        ]
    },
    {
        "name": "CRAN-archive",
        "title": "CRAN archive",
        "description": "CRAN's archive of Windows and macOS binary packages for R versions that the main CRAN mirrors no longer serve.",
        "enabled": true,
        "repos": [
            {
                "name": "CRAN-archive",
                "url": "https://cran-archive.r-project.org/",
                "rversions": [
                    "< 4.0.0"
                ],
                "platforms": [
                    "windows",
                    "*-mingw32",
                    "macos",
                    "*-apple-darwin*"
                ]
            }
        ]
    },
    {
        "name": "Bioconductor",
        "title": "Open source software for Bioinformatics",
        "description": "The Bioconductor software, annotation, experiment data, workflow and book repositories. The URLs are expanded to the Bioconductor mirror and the Bioconductor version that matches the current R version.",
        "enabled": false,
        "repos": [
            {
                "name": "BioCsoft",
                "url": "%bm/packages/%v/bioc"
            },
            {
                "name": "BioCann",
                "url": "%bm/packages/%v/data/annotation"
            },
            {
                "name": "BioCexp",
                "url": "%bm/packages/%v/data/experiment"
            },
            {
                "name": "BioCworkflows",
                "url": "%bm/packages/%v/workflows"
            },
            {
                "name": "BioCbooks",
                "url": "%bm/packages/%v/books"
            }
        ]
